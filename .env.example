# ============================================================================
# Maps Live Demo — Environment Configuration Template
# Copy this file to `.env` (or export variables in your shell) before running.
# ============================================================================

# [Required] Server-side Gemini API Key (used by WebSocket proxy to connect to
# wss://generativelanguage.googleapis.com/...BidiGenerateContent; never exposed to browser)
GEMINI_KEY=your_gemini_api_key_here

# [Required] Google Maps Platform API Key (used by Maps JavaScript SDK + Places + Directions API)
# Recommended enabled APIs:
#   - Maps JavaScript API
#   - Places API (New) & Places API
#   - Directions API
#   - Geocoding API
MAPS_KEY=your_google_maps_api_key_here

# [Optional] Server listen host & port (default: 127.0.0.1:8080 behind reverse proxy)
HOST=127.0.0.1
PORT=8080

# [Optional] Access password for full-site authentication gate (/login + 7-day HttpOnly cookie + IP brute-force lockout).
# Leave empty for public access, or set a strong password to protect /, /ws, /api/*, and /stats.
ACCESS_PASSWORD=

# [Optional] Access token for /stats and /api/stats dashboard only (when ACCESS_PASSWORD is empty).
STATS_TOKEN=

# [Optional] WebSocket idle timeout and max session lifetime in seconds
WS_IDLE_TIMEOUT=900
WS_MAX_LIFETIME=21600
